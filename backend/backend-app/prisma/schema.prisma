/*
 * Debit Note (against a SUPPLIER) / Credit Note (against a
 * CUSTOMER) - a pure accounting adjustment to what a party owes,
 * raised for a reason that ISN'T a physical goods return (rate
 * correction, a discount agreed after the bill, interest/penalty,
 * compensation for damage without a formal return, a rounding
 * fix...). Purchase Return / Sale Return already cover the
 * stock-moving case and post their own ledger entries; this is the
 * no-stock-movement sibling. Always reduces the party's balance -
 * a debit note lowers what we owe a supplier, a credit note lowers
 * what a customer owes us - mirroring PURCHASE_RETURN/RECEIPT's own
 * sign convention in LedgerService.
 */
model AdjustmentNote {
  id String @id @default(cuid())

  noteNo   String @unique
  noteType String // DEBIT | CREDIT

  noteDate DateTime

  partyType String // SUPPLIER | CUSTOMER
  partyId   String

  reason String

  referenceType String?
  referenceId   String?

  taxableAmount Decimal @db.Decimal(14, 2)
  cgstAmount    Decimal @db.Decimal(14, 2)
  sgstAmount    Decimal @db.Decimal(14, 2)
  igstAmount    Decimal @db.Decimal(14, 2)
  netAmount     Decimal @db.Decimal(14, 2)

  status String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items AdjustmentNoteItem[]

  @@index([partyType, partyId])
  @@index([noteType])
  @@index([noteDate])
}

model AdjustmentNoteItem {
  id               String @id @default(cuid())
  adjustmentNoteId String

  // Free text, not tied to the Item catalog - a debit/credit note
  // is usually raised for a reason ("rate difference on Bill
  // #123", "damaged in transit"), not a re-billing of a catalog
  // item.
  description String
  hsnCode     String?

  taxableAmount Decimal @db.Decimal(14, 2)
  gstPercent    Decimal @db.Decimal(5, 2)
  cgstAmount    Decimal @db.Decimal(14, 2)
  sgstAmount    Decimal @db.Decimal(14, 2)
  igstAmount    Decimal @db.Decimal(14, 2)
  netAmount     Decimal @db.Decimal(14, 2)

  adjustmentNote AdjustmentNote @relation(fields: [adjustmentNoteId], references: [id], onDelete: Cascade)

  @@index([adjustmentNoteId])
}

/*
 * Writes off stock that's expired, broken, or spoiled - removes it
 * from WarehouseStock/StockLedger like any other outgoing
 * movement, and books its cost value as a loss (surfaced as a
 * negative-profit line in the Profit Report and the dashboard's
 * Total Profit tile) rather than letting it silently vanish from
 * inventory counts with no financial trace.
 */
model StockDamage {
  id String @id @default(cuid())

  damageNo   String   @unique
  damageDate DateTime

  warehouseId String
  itemId      String
  batchId     String

  qty Decimal @db.Decimal(14, 2)

  // qty * the batch's purchaseRate at the time of write-off - the
  // loss value booked against Profit Report / dashboard totals.
  costValue Decimal @db.Decimal(14, 2)

  reason String

  status String @default("ACTIVE")

  createdAt DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])
  batch     Batch     @relation(fields: [batchId], references: [id])

  @@index([warehouseId])
  @@index([itemId])
  @@index([batchId])
  @@index([damageDate])
}

/*
 * A quick cash-drawer-style expense log (tea, auto fare,
 * stationery...) - posted as a normal PAYMENT ledger entry against
 * a synthetic HOUSE party so it automatically shows up in Cash
 * Book / Card Book / UPI Book alongside everything else, with zero
 * changes needed to those reports.
 */
model PettyExpense {
  id String @id @default(cuid())

  expenseNo   String   @unique
  expenseDate DateTime

  category String
  amount   Decimal @db.Decimal(12, 2)

  paymentMode String @default("CASH")

  remarks String?

  createdAt DateTime @default(now())

  @@index([expenseDate])
  @@index([category])
}

