generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum PriceSource {
  MANUAL
  PURCHASE_UPDATE
  IMPORT
  PROMOTION
  SYSTEM
}

enum BatchStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  BLOCKED
}

enum BatchCreationReason {
  NEW_ITEM
  PURCHASE_RATE_CHANGED
  MRP_CHANGED
  EXPIRY_CHANGED
  MANUFACTURING_CHANGED
  MANUAL
  GENERAL_ITEM
}

enum SchemeType {
  QUANTITY
  FREE_ITEM
  DISCOUNT
}

model Company {
  id               String   @id @default(cuid())
  name             String
  gstin            String?
  address          String?
  phone            String?
  email            String?
  receiptFontSize  Int      @default(13)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model FinancialYear {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)

  isClosed Boolean   @default(false)
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  closingBalances FinancialYearClosingBalance[]
}

/*
 * A read-only snapshot of each party's closing balance as of a
 * closed financial year's end date - NOT a ledger posting. Every
 * outstanding-balance calculation in this app (customerOutstanding,
 * supplierOutstanding, dashboards, etc.) sums the full LedgerEntry
 * history with no date scoping, so inserting a synthetic "opening
 * balance carried forward" LedgerEntry at close time would double
 * count every party's balance from that point on. This table exists
 * so a closed year's ending position is preserved and reportable
 * (e.g. as the "opening balance" line on a new year's statement)
 * without touching the ledger's running total at all.
 */
model FinancialYearClosingBalance {
  id String @id @default(cuid())

  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])

  partyType String
  partyId   String
  partyName String

  closingBalance Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@unique([financialYearId, partyType, partyId])
  @@index([partyType, partyId])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
  shortcuts   RoleShortcut[]
}

model Permission {
  id        String           @id @default(cuid())
  code      String           @unique
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  roles     RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  fullName     String
  mobile       String?
  isActive     Boolean  @default(true)
  roleId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  role         Role     @relation(fields: [roleId], references: [id])
}

/*
 * =====================================================
 * SHORTCUT REGISTRY
 *
 * Shortcut is the global definition of one action: its
 * default key, its current (rebindable) key, and whether
 * it's globally enabled. RoleShortcut is only needed to
 * EXCLUDE a role from a shortcut that is otherwise
 * globally enabled - no row means "eligible" by default,
 * so most roles need no rows at all.
 * =====================================================
 */

model Shortcut {
  id String @id @default(cuid())

  actionCode String @unique
  label      String
  category   String?

  defaultKey String
  currentKey String

  isEnabled Boolean @default(true)

  // SYSTEM (seeded, wired to hardcoded behavior in a specific
  // page - actionCode is meaningless without matching frontend
  // code) or NAVIGATE (admin-created via the Shortcuts screen -
  // generic "jump to this page" behavior handled by one shared
  // listener, so it works immediately with no code changes).
  actionType String @default("SYSTEM")

  // Only set (and only meaningful) for actionType = NAVIGATE -
  // the app route the shared navigation listener pushes to.
  targetPath String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleOverrides RoleShortcut[]

  @@index([isEnabled])
}

model RoleShortcut {
  id String @id @default(cuid())

  roleId     String
  shortcutId String

  isEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  shortcut Shortcut @relation(fields: [shortcutId], references: [id], onDelete: Cascade)

  @@unique([roleId, shortcutId])
}

model GSTSlab {
  id         String   @id @default(cuid())
  name       String
  percentage Decimal  @db.Decimal(5, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  items      Item[]
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         Item[]
  subCategories SubCategory[]
}

model SubCategory {
  id         String   @id @default(cuid())
  name       String
  categoryId String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  items      Item[]
  category   Category @relation(fields: [categoryId], references: [id])
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     Item[]
}

model Unit {
  id String @id @default(cuid())

  name      String @unique
  shortName String @unique

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  baseItems     Item[] @relation("BaseUnit")
  purchaseItems Item[] @relation("PurchaseUnit")
  saleItems     Item[] @relation("SaleUnit")

  @@index([name])
  @@index([shortName])
}

model Item {
  id                 String               @id @default(cuid())
  itemCode           String               @unique
  name               String
  hsnCode            String?
  barcode            String?
  categoryId         String
  subCategoryId      String?
  brandId            String?
  gstSlabId          String
  baseUnitId         String
  purchaseUnitId     String
  saleUnitId         String
  mrp                Decimal              @db.Decimal(12, 2)
  purchaseRate       Decimal              @db.Decimal(12, 2)

  // Reorder tracking - minQty is the stock floor an item should
  // never fall below; reorderQty is how much to order when it does.
  // Both optional (default 0) so this is opt-in per item.
  minQty     Decimal @default(0) @db.Decimal(12, 2)
  reorderQty Decimal @default(0) @db.Decimal(12, 2)

  // A catch-all item for billing something that isn't in the
  // catalog (a one-off repair, a service charge, scrap). Sold
  // through the normal Item/Batch pipeline via one auto-created
  // placeholder batch, but never stock-tracked - postStock/
  // reverseStock skip it entirely - and its line's own typed-in
  // `description` (SalesBillItem.description) stands in for this
  // item's own name wherever the bill is shown or printed.
  isGeneralItem Boolean @default(false)

  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  batches            Batch[]
  baseUnit           Unit                 @relation("BaseUnit", fields: [baseUnitId], references: [id])
  brand              Brand?               @relation(fields: [brandId], references: [id])
  category           Category             @relation(fields: [categoryId], references: [id])
  gstSlab            GSTSlab              @relation(fields: [gstSlabId], references: [id])
  purchaseUnit       Unit                 @relation("PurchaseUnit", fields: [purchaseUnitId], references: [id])
  saleUnit           Unit                 @relation("SaleUnit", fields: [saleUnitId], references: [id])
  subCategory        SubCategory?         @relation(fields: [subCategoryId], references: [id])
  warehouseStocks    WarehouseStock[]
  purchaseBillItems  PurchaseBillItem[]
  salesBillItems     SalesBillItem[]
  stockLedgers       StockLedger[]
  stockTransferItems StockTransferItem[]
  SaleReturnItem     SaleReturnItem[]
  PurchaseReturnItem PurchaseReturnItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockDamages       StockDamage[]
  salesOrderItems    SalesOrderItem[]
  itemPrices         ItemPrice[]
  partyPrices        PartyPrice[]

  priceHistory PriceHistory[]

  triggeredSchemes Scheme[] @relation("SchemeTriggerItem")
  freeItemSchemes  Scheme[] @relation("SchemeFreeItem")
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouseStocks    WarehouseStock[]
  purchaseBills      PurchaseBill[]
  salesBills         SalesBill[]
  stockLedgers       StockLedger[]
  stockTransfersFrom StockTransfer[]  @relation("FromWarehouse")
  stockTransfersTo   StockTransfer[]  @relation("ToWarehouse")
  SaleReturn         SaleReturn[]
  PurchaseReturn     PurchaseReturn[]
  purchaseOrders     PurchaseOrder[]
  salesOrders        SalesOrder[]
  stockDamages       StockDamage[]
}

model SystemSetting {
  id String @id @default(cuid())

  groupName  String
  settingKey String @unique

  value String

  valueType SettingValueType

  description String?

  isEditable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupName])
}

model WarehouseStock {
  id String @id @default(cuid())

  warehouseId String
  itemId      String
  batchId     String

  quantity Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])
  batch     Batch     @relation(fields: [batchId], references: [id])

  @@unique([warehouseId, itemId, batchId])
  @@index([warehouseId])
  @@index([itemId])
  @@index([batchId])
}

model Batch {
  id String @id @default(cuid())

  // ERP Generated Batch Number
  batchNo String @unique

  // Item
  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  // Pricing
  purchaseRate    Decimal @db.Decimal(12, 2)
  retailRate      Decimal @db.Decimal(12, 2)
  wholesaleRate   Decimal @db.Decimal(12, 2)
  distributorRate Decimal @db.Decimal(12, 2)
  mrp             Decimal @db.Decimal(12, 2)

  // Dates
  expiryDate        DateTime?
  manufacturingDate DateTime?

  // Status
  status         BatchStatus         @default(ACTIVE)
  creationReason BatchCreationReason

  // Audit
  purchaseBillId String?
  purchaseBill   PurchaseBill? @relation(fields: [purchaseBillId], references: [id])

  lastPurchaseDate DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  warehouseStocks     WarehouseStock[]
  purchaseBillItems   PurchaseBillItem[]
  salesBillItems      SalesBillItem[]
  purchaseReturnItems PurchaseReturnItem[]
  saleReturnItems     SaleReturnItem[]
  stockLedgers        StockLedger[]
  stockTransferItems  StockTransferItem[]
  stockDamages        StockDamage[]

  barcodes BatchBarcode[]
}

model BatchBarcode {
  id        String   @id @default(cuid())
  batchId   String
  barcode   String   @unique
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

model StockTransfer {
  id              String              @id @default(cuid())
  transferNo      String              @unique
  transferDate    DateTime
  fromWarehouseId String
  toWarehouseId   String
  remarks         String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  fromWarehouse   Warehouse           @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse           @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  items           StockTransferItem[]
}

model StockTransferItem {
  id              String        @id @default(cuid())
  stockTransferId String
  itemId          String
  batchId         String
  qty             Decimal       @db.Decimal(14, 2)
  createdAt       DateTime      @default(now())
  batch           Batch         @relation(fields: [batchId], references: [id])
  item            Item          @relation(fields: [itemId], references: [id])
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id])
}

model StockLedger {
  id              String    @id @default(cuid())
  transactionDate DateTime
  transactionType String
  itemId          String
  batchId         String
  warehouseId     String
  qtyIn           Decimal   @db.Decimal(14, 2)
  qtyOut          Decimal   @db.Decimal(14, 2)
  referenceType   String?
  referenceId     String?
  remarks         String?
  createdAt       DateTime  @default(now())
  batch           Batch     @relation(fields: [batchId], references: [id])
  item            Item      @relation(fields: [itemId], references: [id])
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])
}

model PurchaseBill {
  id          String    @id @default(cuid())
  billNo      String    @unique
  status      String    @default("ACTIVE")
  billDate    DateTime
  invoiceNo   String?
  invoiceDate DateTime?

  warehouseId     String
  purchaseOrderId String?

  // EXCLUSIVE (default) | INCLUSIVE - how the entered purchase rate
  // on this bill was interpreted. Every stored purchaseRate (here,
  // on PurchaseBillItem, and on Batch) is always tax-exclusive
  // regardless of this flag - it is converted once at save time -
  // so nothing downstream (profit reports, GSTR ITC, analytics)
  // needs to know or care which mode a bill was entered in. This
  // field exists purely so the bill can be re-displayed/edited in
  // the mode it was originally entered.
  taxMode String @default("EXCLUSIVE")

  grossAmount    Decimal @db.Decimal(14, 2)
  discountAmount Decimal @db.Decimal(14, 2)
  taxableAmount  Decimal @db.Decimal(14, 2)
  cgstAmount     Decimal @db.Decimal(14, 2)
  sgstAmount     Decimal @db.Decimal(14, 2)
  igstAmount     Decimal @db.Decimal(14, 2)
  netAmount      Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplierId String

  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  items          PurchaseBillItem[]
  PurchaseReturn PurchaseReturn[]
  Batch          Batch[]
}

model PurchaseBillItem {
  id              String           @id @default(cuid())
  purchaseBillId  String
  itemId          String
  batchId         String
  qty             Decimal          @db.Decimal(14, 2)
  purchaseRate    Decimal          @db.Decimal(12, 2)
  discountPercent Decimal          @db.Decimal(5, 2)
  gstPercent      Decimal          @db.Decimal(5, 2)
  taxableAmount   Decimal          @db.Decimal(14, 2)
  cgstAmount      Decimal          @db.Decimal(14, 2)
  sgstAmount      Decimal          @db.Decimal(14, 2)
  igstAmount      Decimal          @db.Decimal(14, 2)
  netAmount       Decimal          @db.Decimal(14, 2)
  createdAt       DateTime         @default(now())
  batch           Batch            @relation(fields: [batchId], references: [id])
  item            Item             @relation(fields: [itemId], references: [id])
  purchaseBill    PurchaseBill     @relation(fields: [purchaseBillId], references: [id])
  purchaseReturns PurchaseReturn[]
}

model PurchaseReturn {
  id String @id @default(cuid())

  returnNo   String   @unique
  returnDate DateTime

  status String @default("ACTIVE")

  purchaseBillId String

  supplierId  String
  warehouseId String

  grossAmount   Decimal @db.Decimal(14, 2)
  taxableAmount Decimal @db.Decimal(14, 2)

  cgstAmount Decimal @db.Decimal(14, 2)
  sgstAmount Decimal @db.Decimal(14, 2)
  igstAmount Decimal @db.Decimal(14, 2)

  netAmount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  purchaseBill PurchaseBill @relation(fields: [purchaseBillId], references: [id])

  supplier Supplier @relation(fields: [supplierId], references: [id])

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  items              PurchaseReturnItem[]
  PurchaseBillItem   PurchaseBillItem?    @relation(fields: [purchaseBillItemId], references: [id])
  purchaseBillItemId String?
}

model PurchaseReturnItem {
  id String @id @default(cuid())

  purchaseReturnId String

  itemId  String
  batchId String

  qty Decimal @db.Decimal(14, 2)

  purchaseRate Decimal @db.Decimal(12, 2)

  gstPercent Decimal @db.Decimal(5, 2)

  taxableAmount Decimal @db.Decimal(14, 2)

  cgstAmount Decimal @db.Decimal(14, 2)
  sgstAmount Decimal @db.Decimal(14, 2)
  igstAmount Decimal @db.Decimal(14, 2)

  netAmount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id])

  item Item @relation(fields: [itemId], references: [id])

  batch Batch @relation(fields: [batchId], references: [id])
}

model Supplier {
  id             String           @id @default(cuid())
  supplierCode   String           @unique
  name           String
  gstType        String
  gstin          String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  mobile         String?
  email          String?
  openingBalance Decimal          @default(0) @db.Decimal(14, 2)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  purchaseBills  PurchaseBill[]
  PurchaseReturn PurchaseReturn[]
  purchaseOrders PurchaseOrder[]
}

model Route {
  id        String     @id @default(cuid())
  name      String     @unique
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  customers Customer[]
}

model Salesman {
  id           String      @id @default(cuid())
  salesmanCode String      @unique
  name         String
  mobile       String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  customers    Customer[]
  salesBills   SalesBill[]
}

model PartyPrice {
  id String @id @default(cuid())

  customerId String
  itemId     String

  // Same qty-tiering as ItemPrice.minQty - a customer-specific rate
  // can itself vary by qty, checked before falling back to the
  // item's price-list tiers.
  minQty Decimal @default(1) @db.Decimal(10, 2)

  salePrice Decimal @db.Decimal(12, 2)

  minimumPrice Decimal? @db.Decimal(12, 2)

  maximumDiscountPercent Decimal? @db.Decimal(5, 2)

  effectiveFrom DateTime?
  effectiveTo   DateTime?

  allowManualOverride Boolean @default(true)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  item Item @relation(fields: [itemId], references: [id])

  @@index([customerId])
  @@index([itemId])
  @@index([isActive])
}

model Scheme {
  id String @id @default(cuid())

  name String

  schemeType SchemeType

  /*
   * Item that triggers the scheme when sold.
   */
  itemId String
  item   Item   @relation("SchemeTriggerItem", fields: [itemId], references: [id])

  /*
   * QUANTITY scheme (e.g. 10+1):
   * every buyQty of the trigger item sold gives freeQty
   * of the SAME item free.
   */
  buyQty  Decimal? @db.Decimal(10, 2)
  freeQty Decimal? @db.Decimal(10, 2)

  /*
   * FREE_ITEM scheme:
   * buying buyQty of the trigger item gives freeQty of
   * freeItemId free (a different item).
   */
  freeItemId String?
  freeItem   Item?   @relation("SchemeFreeItem", fields: [freeItemId], references: [id])

  /*
   * DISCOUNT scheme:
   * flat percentage off the trigger item's line.
   */
  discountPercent Decimal? @db.Decimal(5, 2)

  isActive Boolean @default(true)

  effectiveFrom DateTime?
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesBillItems SalesBillItem[]

  @@index([itemId])
  @@index([isActive])
}

model Customer {
  id            String @id @default(cuid())
  customerCode  String @unique
  name          String
  customerGroup String

  priceLevel String?

  priceListId String?

  priceList      PriceList?   @relation(fields: [priceListId], references: [id])
  gstCategory    String
  gstin          String?
  mobile         String?
  email          String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  openingBalance Decimal      @default(0) @db.Decimal(14, 2)
  creditLimit    Decimal      @default(0) @db.Decimal(14, 2)
  routeId        String?
  salesmanId     String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  route          Route?       @relation(fields: [routeId], references: [id])
  salesman       Salesman?    @relation(fields: [salesmanId], references: [id])
  salesBills     SalesBill[]
  SaleReturn     SaleReturn[]
  partyPrices    PartyPrice[]
  salesOrders    SalesOrder[]
}

model PriceList {
  id String @id @default(cuid())

  code String @unique

  name String

  description String?

  priority Int @default(1)

  sortOrder Int @default(1)

  color String?

  isDefault Boolean @default(false)

  systemDefined Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers  Customer[]
  itemPrices ItemPrice[]

  priceHistory PriceHistory[]

  @@index([code])
  @@index([name])
  @@index([priority])
  @@index([sortOrder])
  @@index([isActive])
  @@index([isDefault])
}

model ItemPrice {
  id String @id @default(cuid())

  itemId      String
  priceListId String

  // The qty threshold this rate kicks in at - the rate used for a
  // given sale qty is the tier with the highest minQty not
  // exceeding it, among all active tiers for this item+price list.
  // Every item+price list always has at least one tier (minQty 1)
  // for this to fall back to.
  minQty Decimal @default(1) @db.Decimal(10, 2)

  salePrice Decimal @db.Decimal(12, 2)

  minimumPrice Decimal? @db.Decimal(12, 2)

  maximumDiscountPercent Decimal? @db.Decimal(5, 2)

  effectiveFrom DateTime?
  effectiveTo   DateTime?

  allowManualOverride Boolean @default(true)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id])

  priceList PriceList @relation(fields: [priceListId], references: [id])

  @@index([itemId, priceListId])
  @@index([itemId])
  @@index([priceListId])
  @@index([isActive])
}

model PriceHistory {
  id String @id @default(cuid())

  itemId      String
  priceListId String

  oldPrice Decimal @db.Decimal(12, 2)
  newPrice Decimal @db.Decimal(12, 2)

  priceSource PriceSource @default(MANUAL)

  changedAt DateTime @default(now())

  changedBy String?

  remarks String?

  item Item @relation(fields: [itemId], references: [id])

  priceList PriceList @relation(fields: [priceListId], references: [id])

  @@index([itemId])
  @@index([priceListId])
}

model SalesBill {
  id                 String          @id @default(cuid())
  billNo             String          @unique
  billDate           DateTime
  customerId         String?
  warehouseId        String
  salesmanId         String?
  salesOrderId       String?

  // EXCLUSIVE (default) | INCLUSIVE - how the entered sale rate on
  // this bill was interpreted. Every stored saleRate (on
  // SalesBillItem) is always tax-exclusive regardless of this flag -
  // it is converted once at save time - so nothing downstream needs
  // to know or care which mode a bill was entered in. This field
  // exists purely so the bill can be re-displayed/edited in the mode
  // it was originally entered.
  taxMode            String          @default("EXCLUSIVE")

  grossAmount        Decimal         @db.Decimal(14, 2)
  itemDiscountAmount Decimal         @db.Decimal(14, 2)
  billDiscountAmount Decimal         @db.Decimal(14, 2)
  taxableAmount      Decimal         @db.Decimal(14, 2)
  cgstAmount         Decimal         @db.Decimal(14, 2)
  sgstAmount         Decimal         @db.Decimal(14, 2)
  igstAmount         Decimal         @db.Decimal(14, 2)
  netAmount          Decimal         @db.Decimal(14, 2)
  roundOff           Decimal         @default(0) @db.Decimal(14, 2)
  shortAmount        Decimal         @default(0) @db.Decimal(14, 2)
  finalPayable       Decimal         @default(0) @db.Decimal(14, 2)
  isCredit           Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  customer           Customer?       @relation(fields: [customerId], references: [id])
  salesman           Salesman?       @relation(fields: [salesmanId], references: [id])
  warehouse          Warehouse       @relation(fields: [warehouseId], references: [id])
  salesOrder         SalesOrder?     @relation(fields: [salesOrderId], references: [id])
  items              SalesBillItem[]
  saleReturns        SaleReturn[]
  payments           SalesPayment[]
}

model HeldSale {
  id          String   @id @default(cuid())
  holdName    String?
  customerId  String?
  warehouseId String
  payload     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
  @@index([warehouseId])
  @@index([updatedAt])
}

model SalesPayment {
  id          String  @id @default(cuid())
  salesBillId String
  paymentMode String
  amount      Decimal @db.Decimal(14, 2)

  // Surcharge can be entered as a flat AMOUNT or as a PERCENT of this
  // row's own `amount` - surchargeValue is the raw number the
  // operator typed (a rupee amount or a percentage), surchargeAmount
  // is always the resolved rupee value, computed server-side so
  // downstream totals never have to know which mode was used.
  surchargeType   String  @default("AMOUNT")
  surchargeValue  Decimal @default(0) @db.Decimal(14, 2)
  surchargeAmount Decimal @default(0) @db.Decimal(14, 2)

  transactionNo String?
  remarks       String?
  createdAt     DateTime @default(now())

  salesBill SalesBill @relation(fields: [salesBillId], references: [id], onDelete: Cascade)

  @@index([salesBillId])
  @@index([paymentMode])
}

model SalesBillItem {
  id              String    @id @default(cuid())
  salesBillId     String
  itemId          String
  batchId         String
  qty             Decimal   @db.Decimal(14, 2)
  saleRate        Decimal   @db.Decimal(12, 2)
  discountPercent Decimal   @db.Decimal(5, 2)
  gstPercent      Decimal   @db.Decimal(5, 2)
  taxableAmount   Decimal   @db.Decimal(14, 2)
  cgstAmount      Decimal   @db.Decimal(14, 2)
  sgstAmount      Decimal   @db.Decimal(14, 2)
  igstAmount      Decimal   @db.Decimal(14, 2)
  netAmount       Decimal   @db.Decimal(14, 2)
  createdAt       DateTime  @default(now())
  batch           Batch     @relation(fields: [batchId], references: [id])
  item            Item      @relation(fields: [itemId], references: [id])
  salesBill       SalesBill @relation(fields: [salesBillId], references: [id])

  // Free-text line description, only ever set for a general
  // (non-catalog) item - what actually sold, since the Item master
  // itself is just a shared placeholder ("General Item"). Null for
  // every ordinary catalog item, which keeps showing item.name.
  description String?

  // A return taken back within this same bill (an exchange: sell
  // some items, take one back, net the payment) rather than a
  // separate SaleReturn document. qty/saleRate/taxableAmount/etc.
  // on this row all stay positive - it's the bill-level totals
  // (SalesBill.grossAmount, netAmount, ...) that subtract this
  // row's amounts instead of adding them. Stock is restored for
  // this row (the opposite of a normal sale line), not consumed.
  isReturn Boolean @default(false)

  /*
   * Scheme applied to this line, if any.
   *
   * freeQty is the portion of qty (out of the total qty
   * on this line) that is free because of the scheme -
   * it still reduces stock but contributes zero taxable
   * value. A line created purely as a FREE_ITEM giveaway
   * has freeQty == qty.
   */
  schemeId String?
  scheme   Scheme? @relation(fields: [schemeId], references: [id])
  freeQty  Decimal @default(0) @db.Decimal(14, 2)

  @@index([schemeId])
}

model SaleReturn {
  id String @id @default(cuid())

  returnNo   String   @unique
  returnDate DateTime

  // Null for a direct return - one taken back without a previous
  // sales bill on file (a walk-in return, a lost receipt, stock
  // simply coming back). Every validation that leans on the
  // original bill (matching warehouse/customer, capping returnable
  // qty, forcing rate/GST to match) is skipped for these - the
  // operator's entered item/batch/qty/rate/gst is trusted directly.
  salesBillId String?

  customerId  String?
  warehouseId String

  grossAmount   Decimal @db.Decimal(14, 2)
  taxableAmount Decimal @db.Decimal(14, 2)

  cgstAmount Decimal @db.Decimal(14, 2)
  sgstAmount Decimal @db.Decimal(14, 2)
  igstAmount Decimal @db.Decimal(14, 2)

  netAmount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  salesBill SalesBill? @relation(fields: [salesBillId], references: [id])

  customer Customer? @relation(fields: [customerId], references: [id])

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  items SaleReturnItem[]
  payments SaleReturnPayment[]
}

model SaleReturnPayment {
  id            String   @id @default(cuid())

  saleReturnId  String
  paymentMode   String

  amount        Decimal  @db.Decimal(14, 2)

  cardSurcharge Decimal  @default(0) @db.Decimal(14, 2)

  transactionNo String?
  remarks       String?

  createdAt     DateTime @default(now())

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)

  @@index([saleReturnId])
  @@index([paymentMode])
}

model SaleReturnItem {
  id String @id @default(cuid())

  saleReturnId String

  itemId  String
  batchId String

  qty Decimal @db.Decimal(14, 2)

  saleRate Decimal @db.Decimal(12, 2)

  gstPercent Decimal @db.Decimal(5, 2)

  taxableAmount Decimal @db.Decimal(14, 2)

  cgstAmount Decimal @db.Decimal(14, 2)
  sgstAmount Decimal @db.Decimal(14, 2)
  igstAmount Decimal @db.Decimal(14, 2)

  netAmount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id])

  item Item @relation(fields: [itemId], references: [id])

  batch Batch @relation(fields: [batchId], references: [id])
}

model LedgerEntry {
  id String @id @default(cuid())

  transactionDate DateTime

  partyType String
  partyId   String

  transactionType String

  referenceType String?
  referenceId   String?

  debitAmount  Decimal @db.Decimal(14, 2)
  creditAmount Decimal @db.Decimal(14, 2)

  remarks String?

  // Set only on RECEIPT/PAYMENT entries that were collected into or
  // paid out of a bank account - what bank reconciliation matches
  // against. Left null for cash and for non-money-movement entries
  // (SALE, PURCHASE, etc.).
  bankAccountId String?

  // Set only on the RECEIPT entries posted at the moment of sale
  // (CASH/UPI/CARD) so Cash Book / Card Book / UPI Book can each
  // tally against real point-of-sale collections. Left null for
  // everything else, including manual receipts/payments collected
  // via the Receipts/Payments screens.
  paymentMode String?

  createdAt DateTime @default(now())

  @@index([bankAccountId])
  @@index([paymentMode])
}

// Chart-of-accounts style grouping (e.g. Sundry Debtors, Sundry
// Creditors, Cash-in-Hand, Bank Accounts, Direct/Indirect Expenses)
// - standalone for now, not yet referenced by Customer/Supplier/
// BankAccount; exists so those can be classified under a named
// group for statement/report purposes if that's added later.
model AccountGroup {
  id String @id @default(cuid())

  name        String
  natureType  String
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BankAccount {
  id String @id @default(cuid())

  name          String
  bankName      String
  accountNumber String
  ifscCode      String?

  openingBalance Decimal @default(0) @db.Decimal(14, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions BankTransaction[]

  @@index([isActive])
}

model BankTransaction {
  id String @id @default(cuid())

  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])

  transactionDate DateTime
  description     String
  referenceNo     String?

  debitAmount  Decimal @default(0) @db.Decimal(14, 2)
  creditAmount Decimal @default(0) @db.Decimal(14, 2)

  // UNMATCHED | MATCHED | IGNORED
  status String @default("UNMATCHED")

  // Loose reference to LedgerEntry.id, not a relation - matches this
  // schema's existing style for LedgerEntry's own party/reference
  // fields.
  matchedLedgerEntryId String?

  // MANUAL | IMPORTED
  source String @default("MANUAL")

  createdAt DateTime @default(now())

  @@index([bankAccountId])
  @@index([status])
  @@index([transactionDate])
}

