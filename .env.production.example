# Copy this file to `.env` on the server (same folder as
# docker-compose.yml) and fill in real values. Never commit the real
# `.env` - it holds production secrets.

# The domain pointed at this server, e.g. erp.yourbusiness.com
# Caddy uses this both to route requests and to request a free
# Let's Encrypt SSL certificate automatically.
DOMAIN=erp.example.com

# PostgreSQL credentials - pick your own values, they're created
# fresh on first startup.
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=erp_db

# Signs login tokens - generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Encrypts database backups made by the in-app Backups feature -
# generate with: openssl rand -hex 32
# IMPORTANT: back this key up somewhere safe outside the server. A
# backup file is unrecoverable without it.
BACKUP_ENCRYPTION_KEY=change-me-to-a-64-char-hex-string

# How many days of backups to keep before the nightly job prunes them.
BACKUP_RETENTION_DAYS=30

# Log a warning when a database query takes longer than this (ms).
SLOW_QUERY_THRESHOLD_MS=3000
